[Unit]
Description=pydhcpd - Python DHCP Daemon
Documentation=https://github.com/maravento/pydhcp
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
# Runs as root ("+") so the unprivileged daemon can always open its log;
# "-" keeps a failure here from blocking the DHCP service.
ExecStartPre=-+/bin/sh -c 'touch /var/log/pydhcp.log && chown pydhcpd:pydhcpd /var/log/pydhcp.log && chmod 640 /var/log/pydhcp.log'
ExecStart=/usr/bin/python3 /etc/pydhcp/core/pydhcpd.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
User=pydhcpd
Group=pydhcpd
# systemd creates /run/pydhcp owned by User/Group above on every start and
# removes it on stop -- the daemon writes its PID there, same shape as
# isc-dhcp-server's RuntimeDirectory=dhcp-server.
RuntimeDirectory=pydhcp
RuntimeDirectoryMode=0755
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/pydhcp /var/log
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
